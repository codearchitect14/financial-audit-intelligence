# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=local            # local | ci | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Database. One DSN; the async and sync driver variants are derived from it.
# The host port is 5436, not 5432: this machine runs several Postgres
# containers and the default port is already taken. See infra/.env.
DATABASE_URL=postgresql://fai:fai@localhost:5436/fai
# Note: 5433, not 5432, because 5432 is commonly already in use locally.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Authentication.
# Generate a real value before any deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The application refuses to start in production while this is the default.
JWT_SECRET_KEY=insecure-development-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS. Explicit origins only, comma separated. A wildcard is rejected in
# production.
CORS_ORIGINS=http://localhost:5173

# LLM providers. Both keys are optional in local development; the LLM layer
# degrades to returning cached-only results when no key is configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
LLM_DAILY_CALL_BUDGET=900

# Embeddings. EMBEDDING_DIMENSIONS must match the vector(N) column width in the
# database; changing it requires a migration and a full re-embed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Ingestion. The SEC blocks requests that do not identify the client, so
# SEC_USER_AGENT must carry a real contact address before running ingestion.
SEC_USER_AGENT=FinancialAuditIntelligence your.email@example.com
SEC_REQUESTS_PER_SECOND=8
DATA_DIR=./data

# Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_TYPES=application/pdf,text/plain,text/csv
