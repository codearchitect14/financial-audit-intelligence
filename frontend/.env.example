# Frontend configuration. Copy to .env.
#
# Anything prefixed VITE_ is inlined into the built bundle and is therefore
# PUBLIC. Never put a secret, API key, or credential in this file.

# Base URL for the API. Leave empty in development to use the Vite proxy, which
# makes the browser see a single origin.
VITE_API_BASE_URL=

# Shown in the UI so a tester can tell which environment they are looking at.
VITE_ENVIRONMENT=local
