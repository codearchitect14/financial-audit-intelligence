# Host-side ports and database credentials for the local Docker stack.
# Copy to infra/.env. Never commit infra/.env.
#
# These ports are host bindings only. Inside the compose network the database
# is always reachable as db:5432 regardless of what is set here.
POSTGRES_PORT=5436
API_PORT=8000
FRONTEND_PORT=5173

# Local development credentials. Deployments use a managed database and supply
# these through the platform secret store instead.
POSTGRES_USER=fai
POSTGRES_PASSWORD=fai
POSTGRES_DB=fai
